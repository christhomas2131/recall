# Copy this file to .env.local. npm start auto-detects an authenticated
# Codex or Claude Code CLI before falling back to API mode.
# RECALL_AGENT=auto

# API mode:
RECALL_PROVIDER=openai
RECALL_MODEL=gpt-5.6-luna
OPENAI_API_KEY=your_key_here

# Anthropic alternative:
# RECALL_PROVIDER=anthropic
# RECALL_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=your_key_here

# Custom coding-agent wrapper alternative. See docs/agent-adapters.md.
# RECALL_AGENT=custom
# RECALL_AGENT_COMMAND=/absolute/path/to/recall-agent-wrapper
# RECALL_AGENT_ARGS_JSON=[]

# Optional when Career Churn Furnace is not in the standard sibling folder:
# RECALL_CCF_ROOT=C:\path\to\Career Churn Furnace
